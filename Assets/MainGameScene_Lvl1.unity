  m_Name: 
  m_EditorClassIdentifier: 
  TextRUS: "\u0422\u044B \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B \u043C\u0435\u043D\u044F
    \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C \u0437\u0430\u043F\u0438\u0441\u043A\u0438
