--- !u!114 &270755841
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 270755838}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cb740497a850e0e4a82abc194e8bbd93, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  TextRUS: "\u042D\u0422\u0410 \u041A\u041D\u0418\u0413 \u041E\u0412\u041B\u0410\u0414\u0415\u041B\u0410
    \u041C\u041D\u041E\u0419, \u0423 \u0422\u0415\u0411\u042F \u0411\u0423\u0414\u0415\u0422
    \u041C\u0410\u041A\u0421\u0418\u041C\u0423\u041C 5 \u041C\u0418\u041D\u0423\u0422
    \u0414\u041E \u0422\u041E\u0413\u041E \u041A\u0410\u041A \u0422\u042B \u041F\u0420\u0415\u0412\u0420\u0410\u0422\u0418\u0428\u042C\u0421\u042F
    \u0412 \u041D\u0418\u0425.\n\n\u041F\u041E\u041A\u0410 \u041E\u041D\u0410 \u0423
    \u0422\u0415\u0411\u042F \u0422\u042B \u0421\u041C\u041E\u0416\u0415\u0428\u042C
    \u0418\u0421\u041F\u041E\u041B\u042C\u0417\u041E\u0412\u0410\u0422\u042C \u0418\u0425
    \u041F\u0420\u0415\u0414\u041C\u0415\u0422\u042B \u0418 \u0417\u0410\u0412\u0415\u0420\u0428\u0418\u0422\u042C
    \u0420\u0418\u0422\u0423\u0410\u041B.\n\n\u041F\u0415\u0420\u0412\u0410\u042F
    \u041A\u0423\u041A\u041B\u0410 \u041F\u0420\u042F\u041C\u041E \u0421\u041B\u0415\u0412\u0410
    \u041E\u0422 \u0412\u0425\u041E\u0414\u0410, \u0415\u0429\u0415 \u041E\u0414\u041D\u0423
    \u0422\u042B \u0421\u041C\u041E...\n(\u041A\u0410\u041A\u0418\u0415\u0422\u041E
    \u0421\u0418\u041C\u0412\u041E\u041B\u042B)"
  TextENG: 'THIS BOOK POSSESSED ME, YOU''LL HAVE FIVE MINUTES TOPS BEFORE YOU TURN
    INTO THEM.


    WHILE YOU HAVE IT, YOU CAN USE THEIR ITEMS AND COMPLETE THE
    RITUAL.


    THE FIRST DOLL IS JUST TO THE LEFT OF THE ENTRANCE, ANOTHER ONE
    YOU CAN...

    (SOME SYMBOLS)'
  TextESP: 'ESTE LIBRO ME HA POSEIDO, TENDRAS CINCO MINUTOS COMO MAXIMO ANTES DE
    CONVERTIRTE EN ELLOS.


    MIENTRAS LO TENGAS, PUEDES USAR SUS OBJETOS Y COMPLETAR
    EL RITUAL.


    LA PRIMERA MUNECA ESTA JUSTO A LA IZQUIERDA DE LA ENTRADA, OTRA
    PUEDES--

    (ALGUNOS SIMBOLOS)'
  NoteObject: {fileID: 999134191}
  NoteText: {fileID: 621626120}
  UseButton: {fileID: 1801915577}
  UIManager: {fileID: 919132148032695961}
  NoteSound: {fileID: 492909937}
